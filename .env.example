# Optional fallback only — the primary way to configure SMTP is the
# app itself (Settings → SMTP), which saves to ~/.r3u-remittance/
# outside this OneDrive-synced folder and lets you test the connection
# before saving. Use these env vars instead only if you specifically
# want config-via-file (e.g. scripting). If both exist, the in-app
# Settings take precedence.
#
# Until either is set, the app runs in dry-run mode automatically
# (validates + logs what would be sent, sends nothing).

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cummins South Pacific Accounts Payable <ap-noreply@example.com>"
